root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs like the Transport Fever 3 base game and official mods.
[*.lua]
indent_style = tab
indent_size = 4

[*.{sh,js}]
indent_style = tab

[*.json]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
